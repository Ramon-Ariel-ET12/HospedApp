@using HospedApp.Core.Entities;
@model IEnumerable<Bed>;
@{
    ViewData["Title"] = "Beds";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Buscar Camas</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    <div class="overflow-x-auto">
        @if (Model.Count() == 0 && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron camas.</p>
        }
        else
        {
            <h3>Lista de Camas</h3>
            <div class="container ds">
                <div class="row">
                    <div class="col-2 d-none d-sm-block">Nombre</div>
                    <div class="col-2 d-none d-sm-block">Pueden dormir</div>
                    <div class="col-2 d-none d-sm-block">Acción</div>
                </div>
                @foreach (var bed in Model)
                {
                    <div class="row">
                        <div class="col-12 col-md-2" data-label="Nombre">@bed.Name</div>
                        <div class="col-12 col-md-2" data-label="Pueden dormir">@bed.CanSleep</div>
                        <div class="col-12 col-md-2" data-label="Acción">
                            <a asp-action="Modify" asp-route-id="@bed.IdBed">Modificar</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>