@using HospedApp.Core.Entities;
@model IEnumerable<Bed>;
@{
    ViewData["Title"] = "Beds";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Lista de Camas</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    
    <div class="table-responsive">
        @if (Model.Count() == 0 && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron camas.</p>
        }
        else
        {

            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Capacidad máxima</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bed in Model)
                    {
                        <tr>
                            <td>@bed.Name</td>
                            <td>@bed.CanSleep</td>
                            <td>
                                <a asp-action="Modify" asp-route-id="@bed.IdBed">Modificar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
