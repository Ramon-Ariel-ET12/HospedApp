@using HospedApp.Core.Entities;
@using HospedApp.Core.Entities.Relations
@model IEnumerable<Reservation>;
@{
    ViewData["Title"] = "Reservas canceladas";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Reservas canceladas</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    <div class="overflow-x-auto">
        @if (Model == null && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron reservas canceladas.</p>
        }
        else
        {
            <h3>Lista de reservas canceladas</h3>
            <div class="container ds">
                <div class="row">
                    <div class="col-2 d-none d-sm-block">Cliente</div>
                    <div class="col-2 d-none d-sm-block">Hotel</div>
                    <div class="col-2 d-none d-sm-block">Domicilio</div>
                    <div class="col-2 d-none d-sm-block">Numero de cuarto</div>
                    <div class="col-2 d-none d-sm-block">Fecha de inicio</div>
                    <div class="col-2 d-none d-sm-block">Fecha de fin</div>
                    <div class="col-2 d-none d-sm-block">Acción</div>
                </div>
                @foreach (var reservation in Model!)
                {
                    <div class="row">
                        <div class="col-12 col-md-2" data-label="Cliente">@string.Concat(reservation.Client!.LastName, " ", reservation.Client!.Name)</div>
                        <div class="col-12 col-md-2" data-label="Hotel">@reservation.Address!.Hotel!.Name</div>
                        <div class="col-12 col-md-2" data-label="Domicilio">@reservation.Address!.Domicile</div>
                        <div class="col-12 col-md-2" data-label="Numero de cuarto">@reservation.RoomBed!.IdRoomBed</div>
                        <div class="col-12 col-md-2" data-label="Fecha de inicio">@reservation.StartDate!.Value.ToShortDateString()</div>
                        <div class="col-12 col-md-2" data-label="Fecha de fin">@reservation.EndDate!.Value.ToShortDateString()</div>
                        <div class="col-12 col-md-2" data-label="Acción">
                            <a asp-controller="Hotel" asp-action="DetailAddress" asp-route-id="@reservation.Address.IdAddress">Detalle</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>