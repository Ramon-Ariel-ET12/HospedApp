@using HospedApp.Core.Entities;
@using HospedApp.Core.Entities.Relations
@model IEnumerable<Reservation>;
@{
    ViewData["Title"] = "Reservas";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div>
    <br>
    <div class="text-center">
        <h1>Reservas</h1>
    </div>
    <br>

    <div class="input-group mb-3 input">
        <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
    </div>
    <div>
        @if (Model == null && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron reservas.</p>
        }
        else
        {
            <h3>Lista de reservas</h3>
            <div>
                <table class="table table-responsive table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Cliente</th>
                            <th scope="col">Comentario del cliente</th>
                            <th scope="col">Hotel</th>
                            <th scope="col">Domicilio</th>
                            <th scope="col">Numero de cuarto</th>
                            <th scope="col">Fecha de inicio</th>
                            <th scope="col">Fecha de fin</th>
                            <th scope="col">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model!)
                        {
                            <tr>
                                <td data-label="Cliente">@string.Concat(reservation.Client!.LastName, " ", reservation.Client!.Name)</td>
                                <td data-label="Comentario del cliente">@reservation.ClientComment</td>
                                <td data-label="Hotel">@reservation.Address!.Hotel!.Name</td>
                                <td data-label="Domicilio">@reservation.Address!.Domicile</td>
                                <td data-label="Numero de cuarto">@reservation.RoomBed!.IdRoomBed</td>
                                <td data-label="Fecha de inicio">@reservation.StartDate!.Value.ToShortDateString()</td>
                                <td data-label="Fecha de fin">@reservation.EndDate!.Value.ToShortDateString()</td>
                                <td data-label="Acción">
                                    <a asp-controller="Hotel" asp-action="DetailAddress" asp-route-id="@reservation.Address.IdAddress">Detalle</a>
                                    <a asp-controller="Reservation" asp-action="Cancell" asp-route-id="@reservation.IdReservation">Cancelar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>