@using HospedApp.Core.Entities;
@model IEnumerable<Client>;
@{
    ViewData["Title"] = "Clientes";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Buscar Clientes</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    
    <!-- Contenedor para desplazamiento -->
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Dni</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Sexo</th>
                    <th>Email</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td>@client.Dni</td>
                        <td>@client.Name</td>
                        <td>@client.LastName</td>
                        <td>@client.Sex</td>
                        <td>@client.Email</td>
                        <td>
                            <a asp-action="Modify" asp-route-id="@client.IdClient">Modificar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
