@using HospedApp.Core.Entities;
@model IEnumerable<Client>;
@{
    ViewData["Title"] = "Clientes";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Buscar Clientes</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    <div class="overflow-x-auto">
        @if (Model.Count() == 0 && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron clientes.</p>
        }
        else
        {
            <h3>Lista de Clientes</h3>
            <div class="container ds">
                <div class="row">
                    <div class="col-2 d-none d-sm-block">Dni</div>
                    <div class="col-2 d-none d-sm-block">Nombre</div>
                    <div class="col-2 d-none d-sm-block">Apellido</div>
                    <div class="col-2 d-none d-sm-block">Sexo</div>
                    <div class="col-2 d-none d-sm-block">Email</div>
                    <div class="col-2 d-none d-sm-block">Acción</div>
                </div>
                @foreach (var client in Model)
                {
                    <div class="row">
                        <div class="col-12 col-md-2" data-label="Dni">@client.Dni</div>
                        <div class="col-12 col-md-2" data-label="Nombre">@client.Name</div>
                        <div class="col-12 col-md-2" data-label="Apellido">@client.LastName</div>
                        <div class="col-12 col-md-1" data-label="Sex">@client.Sex</div>
                        <div class="col-12 col-md-2" data-label="Email">@client.Email</div>
                        <div class="col-12 col-md-2" data-label="Acción">
                            <a asp-action="Modify" asp-route-id="@client.IdClient">Modificar</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>