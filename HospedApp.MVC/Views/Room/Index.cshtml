@using HospedApp.Core.Entities;
@using HospedApp.Core.Entities.Relations
@model IEnumerable<RoomBed>;
@{
    ViewData["Title"] = "Rooms";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Buscar Cuartos</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    <div class="overflow-x-auto">
        @if (Model.Count() == 0 && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron cuartos.</p>
        }
        else
        {
            <h3>Lista de Cuartos</h3>
            <div class="container ds">
                <div class="row">
                    <div class="col-2 d-none d-sm-block">Id del cuarto</div>
                    <div class="col-2 d-none d-sm-block">Garage</div>
                    <div class="col-2 d-none d-sm-block">Cama</div>
                    <div class="col-2 d-none d-sm-block">Cantidad</div>
                    <div class="col-2 d-none d-sm-block">Descripcion</div>
                    <div class="col-2 d-none d-sm-block">Precio por noche</div>
                    <div class="col-2 d-none d-sm-block">Acción</div>
                </div>
                @foreach (var roomBed in Model)
                {
                    <div class="row">
                        <div class="col-12 col-md-2" data-label="Id del cuarto">@roomBed.IdRoomBed</div>
                        <div class="col-12 col-md-2" data-label="Garage">@roomBed.Room!.Garage</div>
                        <div class="col-12 col-md-2" data-label="Cama">@roomBed.Bed!.Name</div>
                        <div class="col-12 col-md-2" data-label="Cantidad">@roomBed.BedQuantity</div>
                        <div class="col-12 col-md-2" data-label="Descripcion">@roomBed.Room.Description</div>
                        <div class="col-12 col-md-2" data-label="Precio por noche">@roomBed.Room.PriceNight</div>
                        <div class="col-12 col-md-2" data-label="Acción">
                            <a asp-action="Modify" asp-route-id="@roomBed.IdRoomBed">Modificar</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>