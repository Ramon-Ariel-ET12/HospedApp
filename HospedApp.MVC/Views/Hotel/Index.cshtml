@using HospedApp.Core.Entities;
@model IEnumerable<Hotel>;
@{
    ViewData["Title"] = "Hotels";
}
<link rel="stylesheet" href="~/css/listas.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="container">
    <br>
    <div class="text-center">
        <h1>Buscar Hoteles</h1>
        <br>
    </div>
    <div class="row justify-content-center">
        <div class="mb-3 input col-12 col-md-4 align-self-center">
            <input id="searchInput" type="text" class="form-control" placeholder="Buscar">
        </div>
    </div>
    <div class="overflow-x-auto">
        @if (Model.Count() == 0 && Context.Request.RouteValues.ContainsKey("Index"))
        {
            <p>No se encontraron hoteles.</p>
        }
        else
        {
            <h3>Lista de Hoteles</h3>
            <div class="container ds">
                <div class="row">
                    <div class="col-2 d-none d-sm-block">Hotel</div>
                    <div class="col-2 d-none d-sm-block">Email</div>
                    <div class="col-2 d-none d-sm-block">Sitio Web</div>
                    <div class="col-2 d-none d-sm-block">Estrella</div>
                    <div class="col-2 d-none d-sm-block">Acción</div>
                </div>
                @foreach (var hotel in Model)
                {
                    <div class="row">
                        <div class="col-12 col-md-2" data-label="Hotel">@hotel.Name</div>
                        <div class="col-12 col-md-2" data-label="Email">@hotel.Email</div>
                        <div class="col-12 col-md-2" data-label="Sitio Web">@hotel.Web</div>
                        <div class="col-12 col-md-2" data-label="Estrella">@hotel.Star</div>
                        <div class="col-12 col-md-2" data-label="Acción">
                            <a asp-action="Modify" asp-route-id="@hotel.IdHotel">Modificar</a>
                            <a asp-action="Detail" asp-route-id="@hotel.IdHotel">Detalle</a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>