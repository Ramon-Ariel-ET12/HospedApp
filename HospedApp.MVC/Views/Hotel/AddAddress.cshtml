@using HospedApp.Core.Entities;
@using HospedApp.Core.Entities.Relations;
@model Address;
@{
    var texto = Model != null ? "Modificar Dirección" : "Alta Dirección";
    ViewData["Title"] = texto;
}

<link rel="stylesheet" href="~/css/formulario.css">
<link rel="stylesheet" href="~/css/site.css">

<div class="main-container">
    <div class="container">
        <form asp-controller="Hotel" asp-action="AddAddress" method="post" class="formulario">
            <h2 class="text-center">@texto</h2>
            <div asp-validation-summary="All"></div>

            @if (Model != null)
            {
                <div><input type="hidden" asp-for="@Model.IdAddress" /></div>
            }

            <div><input type="hidden" asp-for="Hotel!.IdHotel" value="@ViewBag.IdHotel" /></div>


            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Domicile" class="form-label">Domicilio</label>
                    <input asp-for="Domicile" type="text" class="form-control" placeholder="Ingrese el domicilio" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="PostalCode" class="form-label">Código Postal</label>
                    <input asp-for="PostalCode" type="text" class="form-control" placeholder="Ingrese el código postal" required />
                </div>
            </div>


            <div class="text-center mb-3">
                @if (Model != null)
                {
                    <button type="submit" class="btn btn-warning">@texto</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">@texto</button>
                }
            </div>
        </form>
    </div>
</div>
